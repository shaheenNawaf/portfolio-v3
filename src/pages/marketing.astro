---
import BaseLayout from "../layouts/layout.astro";
import IdentityHero from "../components/identity_hero.astro";
import SectionDivider from "../components/section_divider.astro";
import SectionHead from "../components/section_head.astro";
import WorkCard from "../components/work_card.astro";
import JourneyRow from "../components/journey_row.astro";
import BookCall from "../components/book_call.astro";
import SiteFooter from "../components/site_footer.astro";

import {
  name,
  marketingSummary,
  marketingSkills,
  featuredProjectIds,
  marketingFit,
} from "../data/resume";
import { getExperiences, getProjects } from "../data/content";

const projects = await getProjects();
const experiences = await getExperiences();

const visible = projects.filter((p) => !p.draft);

const featured = featuredProjectIds.marketing
  .map((id) => visible.find((p) => p.id === id))
  .filter((p): p is (typeof visible)[number] => Boolean(p));

const featuredIds = new Set<string>(featuredProjectIds.marketing);
const moreProjects = visible.filter(
  (p) => p.category === "marketing" && !featuredIds.has(p.id),
);
const marketingExp = experiences.filter((e) => e.category === "marketing");
---

<BaseLayout
  title="Shaheen Al Adwani | Growth & Influencer Marketing (4:1 ROAS)"
  description="Growth marketer in the Philippines: $355K campaign volume, 4:1 ROAS across SEA creator partnerships, 22K-member communities. Open to remote roles."
  track="marketing"
  crumbs={[{ name: "Growth Marketing", path: "/marketing" }]}
>
  <main id="main" class="wrap flex flex-col gap-8 sm:gap-10 pt-10 md:pt-16 pb-4">
    <IdentityHero
      name={name}
      headline="Growth Marketing"
      summary={marketingSummary}
      skills={marketingSkills}
      mode="marketing"
      impactBadge="$355K+ Managed Volume in 4 months"
    />
    <p class="mt-6 text-[12px] faint" data-reveal style="--i:2">
      Creator partnerships, community systems, and performance plays that move
      volume.
    </p>

    <div data-reveal style="--i:3">
      <SectionDivider />
      <section>
        <SectionHead
          title="Flagship campaigns"
          subtitle="Volume, ROAS, and systems, not just creative drops."
        />
        <div class="mt-6 grid grid-flow-row-dense grid-cols-1 gap-4 sm:grid-cols-2">
          {featured.map((p, i) => p && <WorkCard {...p} index={i} />)}
        </div>
      </section>
    </div>

    <div data-reveal style="--i:4">
      <SectionDivider />
      <section>
        <SectionHead title="Good fit when you need" />
        <ul class="mt-5 space-y-3">
          {
            marketingFit.map((item) => (
              <li class="flex items-start gap-3 text-[14px] muted leading-[1.7]">
                <span
                  class="mt-[7px] w-1.5 h-1.5 rounded-full shrink-0"
                  style="background-color: var(--mkt)"
                ></span>
                {item}
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    {
      moreProjects.length > 0 && (
        <div data-reveal style="--i:5">
          <SectionDivider />
          <section>
            <SectionHead title="More campaigns" />
            <div class="mt-6 grid grid-flow-row-dense grid-cols-1 gap-4 sm:grid-cols-2">
              {moreProjects.map((p, i) => (
                <WorkCard {...p} index={i} />
              ))}
            </div>
          </section>
        </div>
      )
    }

    <div data-reveal style="--i:6">
      <SectionDivider />
      <section>
        <SectionHead title="Professional history" />
        <div class="mt-6 timeline">
          {
            marketingExp.map((exp) => (
              <JourneyRow {...exp} />
            ))
          }
        </div>
      </section>
    </div>

    <div data-reveal style="--i:7">
      <SectionDivider />
      <section>
        <BookCall
          defaultInterest="marketing"
          title="Book a studio intro"
          subtitle="Talk growth systems, creator ops, and SEA markets. Full-time preferred."
        />
      </section>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
