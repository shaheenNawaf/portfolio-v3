---
import BaseLayout from "../layouts/layout.astro";
import SiteFooter from "../components/site_footer.astro";
import { name, contact, resumes } from "../data/resume";
---

<BaseLayout
  title={`Page not found · ${name}`}
  description="The page you are looking for does not exist."
  noindex
>
  <main id="main" class="wrap min-h-[70dvh] flex items-center justify-center">
    <div class="text-center">
      <p class="eyebrow">404</p>
        <h1 class="mt-3 text-h1 md:text-h1-lg font-semibold tracking-[-0.02em] leading-[1.15]">
        Page not found
      </h1>
      <p class="mt-4 text-[15px] muted leading-[1.7] max-w-md mx-auto">
        The page you are looking for does not exist or has been moved. Pick a
        destination below.
      </p>
      <div
        class="mt-8 flex flex-wrap items-center justify-center gap-6 text-[13px]"
      >
        <a
          href="/"
          class="font-semibold fg underline-offset-4 hover:underline"
        >
          Back to home →
        </a>
        <a
          href={`https://${contact.linkedin}`}
          target="_blank"
          rel="noopener noreferrer"
          class="muted hover:text-[color:var(--text)] transition-colors"
        >
          LinkedIn ↗
        </a>
        <a
          href={resumes.software}
          target="_blank"
          rel="noopener noreferrer"
          class="muted hover:text-[color:var(--text)] transition-colors"
        >
          Software Eng resume ↗
        </a>
        <a
          href={resumes.marketing}
          target="_blank"
          rel="noopener noreferrer"
          class="muted hover:text-[color:var(--text)] transition-colors"
        >
          Marketing resume ↗
        </a>
      </div>
      <div
        class="mt-8 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-[12px] faint"
      >
        <a
          href="/#work"
          class="hover:text-[color:var(--text)] transition-colors"
          >Work</a
        >
        <span>/</span>
        <a
          href="/#experience"
          class="hover:text-[color:var(--text)] transition-colors"
          >Experience</a
        >
        <span>/</span>
        <a
          href={`mailto:${contact.email}`}
          class="hover:text-[color:var(--text)] transition-colors"
          >{contact.email}</a
        >
      </div>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
