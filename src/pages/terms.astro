---
import BaseLayout from "../layouts/layout.astro";
---

<BaseLayout
  title="Terms of Use — Shaheen Al Adwani"
  description="The terms that apply when using shaheen.works: content license, ownership, third-party trademarks, and disclaimers."
>
  <main id="main" class="wrap pt-10 pb-16">
    <h1 class="text-[22px] md:text-[26px] font-medium tracking-[-0.01em]">
      Terms of Use
    </h1>
    <p class="mt-1 text-[12px] faint">Effective 2026-09-25 · shaheen.works</p>

    <div class="mt-8 space-y-8 text-[14px] muted leading-[1.7]">
      <section class="space-y-3">
        <h2 class="text-[15px] font-semibold tracking-tight fg">Acceptance</h2>
        <p>
          By accessing shaheen.works you agree to these terms. If you do not
          agree, please do not use the site.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-[15px] font-semibold tracking-tight fg">License to view</h2>
        <p>
          You may view the site and share links to it for personal,
          non-commercial purposes. You may not republish, sell, or redistribute
          its content without written permission.
        </p>
