---
import BaseLayout from "../layouts/layout.astro";
import IdentityHero from "../components/identity_hero.astro";
import SectionDivider from "../components/section_divider.astro";
import SectionHead from "../components/section_head.astro";
import WorkCard from "../components/work_card.astro";
import JourneyRow from "../components/journey_row.astro";
import BookCall from "../components/book_call.astro";
import SiteFooter from "../components/site_footer.astro";

import {
  name,
  softwareSummary,
  softwareSkills,
  featuredProjectIds,
  softwareFit,
  trustLogos,
} from "../data/resume";
import { getExperiences, getProjects } from "../data/content";

const projects = await getProjects();
const experiences = await getExperiences();

const visible = projects.filter((p) => !p.draft);

const featured = featuredProjectIds.software
  .map((id) => visible.find((p) => p.id === id))
  .filter((p): p is (typeof visible)[number] => Boolean(p));

const featuredIds = new Set<string>(featuredProjectIds.software);
const moreProjects = visible.filter(
  (p) => p.category === "software" && !featuredIds.has(p.id),
);
const softwareExp = experiences.filter((e) => e.category === "software");
---

<BaseLayout
  title="Shaheen Al Adwani | Full-Stack Software Engineer (Flutter, Next.js)"
  description="Full-stack software engineer in the Philippines building SaaS with Flutter, Next.js, Spring Boot and Supabase. Live products with real users. Open to remote roles."
  track="software"
  crumbs={[{ name: "Software Engineering", path: "/software" }]}
>
  <main id="main" class="wrap flex flex-col gap-8 sm:gap-10 pt-10 md:pt-16 pb-4">
    <IdentityHero
      name={name}
      headline="Full-stack Software Engineer & Project Manager"
      summary={softwareSummary}
      skills={softwareSkills}
      mode="software"
      impactBadge="Dean's List · Ateneo de Davao"
    />
    <p class="mt-6 text-[12px] faint" data-reveal style="--i:2">
      Partnerships include: {trustLogos.map((l) => l.alt).join(" · ")}
    </p>

    <div data-reveal style="--i:3">
      <SectionDivider />
      <section>
        <SectionHead
          title="Flagship builds"
          subtitle="Depth over volume. Live systems and real users."
        />
        <div class="mt-6 grid grid-flow-row-dense grid-cols-1 gap-4 sm:grid-cols-2">
          {featured.map((p, i) => p && <WorkCard {...p} index={i} />)}
        </div>
      </section>
    </div>

    <div data-reveal style="--i:4">
      <SectionDivider />
      <section>
        <SectionHead title="Good fit when you need" />
        <ul class="mt-5 space-y-3">
          {
            softwareFit.map((item) => (
              <li class="flex items-start gap-3 text-[14px] muted leading-[1.7]">
                <span
                  class="mt-[7px] w-1.5 h-1.5 rounded-full shrink-0"
                  style="background-color: var(--sw)"
                ></span>
                {item}
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    {
      moreProjects.length > 0 && (
        <div data-reveal style="--i:5">
          <SectionDivider />
          <section>
            <SectionHead title="More projects" />
            <div class="mt-6 grid grid-flow-row-dense grid-cols-1 gap-4 sm:grid-cols-2">
              {moreProjects.map((p, i) => (
                <WorkCard {...p} index={i} />
              ))}
            </div>
          </section>
        </div>
      )
    }

    <div data-reveal style="--i:6">
      <SectionDivider />
      <section>
        <SectionHead title="Engineering history" />
        <div class="mt-6 timeline">
          {
            softwareExp.map((exp) => (
              <JourneyRow {...exp} />
            ))
          }
        </div>
      </section>
    </div>

    <div data-reveal style="--i:7">
      <SectionDivider />
      <section>
        <BookCall
          defaultInterest="software"
          title="Book a lab intro"
          subtitle="Talk product, stack, and how I ship. Full-time preferred."
        />
      </section>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
