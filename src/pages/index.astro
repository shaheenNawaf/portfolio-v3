---
import BaseLayout from "../layouts/layout.astro";
import HeroHome from "../components/hero_home.astro";
import FitLanes from "../components/fit_lanes.astro";
import SectionDivider from "../components/section_divider.astro";
import SectionHead from "../components/section_head.astro";
import SecretTooltip from "../components/secret_tooltip.astro";
import CategorySwitcher from "../components/category_switcher.astro";
import WorkCard from "../components/work_card.astro";
import JourneyRow from "../components/journey_row.astro";
import SkillsGrid from "../components/skills_grid.astro";
import BookCall from "../components/book_call.astro";
import SiteFooter from "../components/site_footer.astro";
import StickerPill from "../components/sticker_pill.astro";
import { name, showcaseProjectIds, secrets, hub, contact, socials } from "../data/resume";
import { getExperiences, getProjects } from "../data/content";

const projects = await getProjects();
const experiences = await getExperiences();

const visible = projects.filter((p) => !p.draft);
const showcase = showcaseProjectIds
  .map((id) => visible.find((p) => p.id === id))
  .filter((p) => p !== undefined);
const archive = visible.filter((p) => !showcaseProjectIds.includes(p.id));

// Start the most recent role that has bullets open, so its outcomes are
// visible without a click.
const firstDetailedExperience = experiences.findIndex((e) => e.details.length > 0);

// Only offer filters that have something to show.
const workCategories = [
  { id: "all", label: "All" },
  { id: "software", label: "Software" },
  { id: "marketing", label: "Growth" },
  { id: "systems", label: "Systems" },
].filter((c) => c.id === "all" || visible.some((p) => p.category === c.id));
---

<BaseLayout
  title={`${name} | Full-Stack Developer & Growth Marketer`}
  description="Full-stack developer (Flutter, Next.js) and growth marketer (4:1 ROAS, $355K campaign volume) in Davao, Philippines. 2 live SaaS products. Open to remote roles in SEA."
>
  <main id="main" class="wrap flex flex-col gap-8 sm:gap-10 pt-10 md:pt-16 pb-4">
    <HeroHome />

    <div data-reveal>
      <SectionDivider />
      <FitLanes />
    </div>

    <div data-reveal>
      <SectionDivider />
      <section id="work">
        <SectionHead
          title="Selected work"
          subtitle="Products, campaigns, and systems with measurable outcomes."
        />
        <div class="mt-6"><CategorySwitcher categories={workCategories} /></div>
        <div class="mt-6 work-strip" data-project-grid>
          {
            showcase.map((p, i) => (
              <WorkCard {...p} index={i} featured={true} />
            ))
          }
          {
            archive.map((p, i) => (
              <WorkCard {...p} index={i + showcase.length} />
            ))
          }
        </div>
        <p class="strip-hint mt-2 justify-end text-[12px] faint" aria-hidden="true">
          Swipe for more →
        </p>
        <script is:inline>
          // Featured cards render open (desktop case studies); collapse them on
          // phones before first paint so the strip doesn't jump on load.
          if (!window.matchMedia("(min-width: 640px)").matches) {
            document
              .querySelectorAll(".work-strip > .work-card[data-featured='true']")
              .forEach(function (c) { c.removeAttribute("open"); });
          }
        </script>
      </section>
    </div>

    <div data-reveal>
      <SectionDivider />
      <section id="experience">
        <SectionHead
          title="Experience"
          subtitle="Professional progression across engineering and growth."
        />
        <div class="mt-6">
          <CategorySwitcher
            targetSelector="[data-experience-list]"
            itemSelector="[data-experience-row]"
            storageKey="experience-category"
            categories={[
              { id: "all", label: "All" },
              { id: "software", label: "Software" },
              { id: "marketing", label: "Growth" },
            ]}
          />
        </div>
        <div class="mt-6 timeline" data-experience-list>
          {
            experiences.map((exp, i) => (
              <div data-experience-row data-category={exp.category}>
                <JourneyRow {...exp} open={i === firstDetailedExperience} />
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <div data-reveal>
      <SectionDivider />
      <SkillsGrid />
    </div>

    <div data-reveal>
      <SectionDivider />
      <section id="contact">
        <p class="eyebrow">
          <SecretTooltip
            trigger={secrets.status.trigger}
            reveal={secrets.status.reveal}
          />
        </p>
        <div class="mt-3">
          <BookCall
            defaultInterest="hybrid"
            title="Let's talk"
            subtitle={hub.appointmentUrl
              ? "Send a short note or book a time. Replies within 24–48 hours."
              : "Send a short note below, or email me directly. Replies within 24–48 hours."}
          >
            <div slot="direct" class="mt-4 flex flex-col gap-3">
              <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[13px] muted">
                <span>{contact.location} · {hub.availability}</span>
              </p>
              <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[14px]">
                <a href={`mailto:${contact.email}`} class="fg font-medium underline decoration-[color:var(--border-strong)] underline-offset-4 hover:decoration-current break-all">
                  {contact.email}
                </a>
                <button
                  type="button"
                  data-copy={contact.email}
                  class="rounded-full border hairline px-2 py-0.5 text-[12px] font-medium muted transition-colors hover:text-[color:var(--text)] hover:border-[color:var(--border-strong)]"
                >
                  <span data-copy-label>Copy</span>
                </button>
              </p>
              <div class="flex flex-wrap items-center gap-2">
                {[socials[1], socials[3], socials[4]].map((s) => (
                  <StickerPill social={s} idPrefix="contact-" />
                ))}
              </div>
            </div>
          </BookCall>
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  // Initial open/closed state is set by the inline script under the work strip.
  // Here we only follow breakpoint changes, and never override a card the
  // visitor has opened or closed themselves.
  const featured = document.querySelectorAll<HTMLElement>(
    ".work-strip > .work-card[data-featured='true']",
  );
  featured.forEach((c) =>
    c.querySelector("summary")?.addEventListener("click", () => {
      c.dataset.userToggled = "true";
    }),
  );

  window.matchMedia("(min-width: 640px)").addEventListener("change", (mq) => {
    featured.forEach((c) => {
      if (c.dataset.userToggled === "true") return;
      c.toggleAttribute("open", mq.matches);
    });
  });

  // Copy-to-clipboard for the contact email.
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    const label = btn.querySelector<HTMLElement>("[data-copy-label]");
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        if (label) label.textContent = "Copied";
      } catch {
        if (label) label.textContent = "Press Ctrl+C";
      }
      window.setTimeout(() => label && (label.textContent = "Copy"), 1800);
    });
  });
</script>
