---
import BaseLayout from "../layouts/layout.astro";
import HeroHome from "../components/hero_home.astro";
import TrackIndex from "../components/track_index.astro";
import SectionDivider from "../components/section_divider.astro";
import SectionHead from "../components/section_head.astro";
import SecretTooltip from "../components/secret_tooltip.astro";
import CategorySwitcher from "../components/category_switcher.astro";
import WorkCard from "../components/work_card.astro";
import JourneyRow from "../components/journey_row.astro";
import SkillsGrid from "../components/skills_grid.astro";
import BookCall from "../components/book_call.astro";
import SiteFooter from "../components/site_footer.astro";
import { name, featuredProjectIds, secrets } from "../data/resume";
import { getExperiences, getProjects } from "../data/content";

const projects = await getProjects();
const experiences = await getExperiences();

const visible = projects.filter((p) => !p.draft);
const featuredSet = new Set<string>([
  ...featuredProjectIds.marketing,
  ...featuredProjectIds.software,
  ...featuredProjectIds.systems,
]);
---

<BaseLayout
  title={`${name} | Full-stack Engineer & Growth Marketer`}
  description="Full-stack software engineer and growth marketer. 2 live SaaS products, $355K+ campaign volume, 4:1 ROAS. Open to full-time roles in SEA."
  track="hub"
>
  <main id="main" class="wrap flex flex-col gap-8 sm:gap-10 pt-10 md:pt-16 pb-4">
    <HeroHome />

    <div data-reveal style="--i:1">
      <SectionDivider />
      <TrackIndex />
    </div>

    <div data-reveal style="--i:2">
      <SectionDivider />
      <section id="work">
        <SectionHead
          title="Selected work"
          subtitle="Products, campaigns, and systems with measurable outcomes."
          actionLabel="See all"
          actionId="work-see-all"
        />
        <div class="mt-6"><CategorySwitcher /></div>
        <div class="mt-6 grid grid-flow-row-dense grid-cols-1 gap-4 sm:grid-cols-2" data-project-grid>
          {
            visible.map((p, i) => (
              <WorkCard {...p} index={i} featured={featuredSet.has(p.id)} />
            ))
          }
        </div>
      </section>
    </div>

    <div data-reveal style="--i:3">
      <SectionDivider />
      <section id="experience">
        <SectionHead
          title="Experience"
          subtitle="Professional progression across engineering and growth."
        />
        <div class="mt-6">
          <CategorySwitcher
            targetSelector="[data-experience-list]"
            itemSelector="[data-experience-row]"
            storageKey="experience-category"
            categories={[
              { id: "all", label: "All" },
              { id: "software", label: "Software" },
              { id: "marketing", label: "Growth Marketing" },
            ]}
          />
        </div>
        <div class="mt-4 timeline" data-experience-list>
          {
            experiences.map((exp) => (
              <div data-experience-row data-category={exp.category}>
                <JourneyRow {...exp} />
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <div data-reveal style="--i:4">
      <SectionDivider />
      <SkillsGrid />
    </div>

    <div data-reveal style="--i:5">
      <SectionDivider />
      <section id="contact">
        <p class="eyebrow">
          <SecretTooltip
            trigger={secrets.status.trigger}
            reveal={secrets.status.reveal}
          />
        </p>
        <div class="mt-3">
          <BookCall
            defaultInterest="hybrid"
            title="Let's talk"
            subtitle="Send a short note or book a time. Replies within 24–48 hours."
          />
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  import { ready } from "../scripts/ready";

  const initSeeAll = () => {
    const btn = document.getElementById("work-see-all");
    const grid = document.querySelector<HTMLElement>("[data-project-grid]");
    if (!btn || !grid) return;

    const label = btn.querySelector<HTMLElement>("[data-label]");
    const cards = Array.from(grid.querySelectorAll<HTMLElement>("[data-project-card]"));
    const switcher = document.querySelector<HTMLElement>(
      '.category-switcher[data-target="[data-project-grid]"]',
    );
    const categoryButtons = switcher
      ? Array.from(switcher.querySelectorAll<HTMLElement>(".category-btn"))
      : [];

    const activeCategory = () =>
      switcher?.querySelector<HTMLElement>('.category-btn[aria-selected="true"]')?.dataset
        .category ?? "all";

    let expanded = activeCategory() !== "all";

    const syncLabel = () => {
      if (label) label.textContent = expanded ? "Show less" : "See all";
    };

    const apply = () => {
      if (activeCategory() === "all") {
        cards.forEach((c) => {
          const show = expanded || c.dataset.featured === "true";
          c.style.display = show ? "" : "none";
          if (show) c.classList.add("is-in", "reveal-done");
        });
      }
      syncLabel();
    };

    btn.addEventListener("click", () => {
      expanded = !expanded;
      apply();
    });

    categoryButtons.forEach((b) => {
      b.addEventListener("click", () => {
        if (b.dataset.category !== "all") expanded = true;
        setTimeout(apply, 0);
      });
    });

    apply();
  };

  ready(initSeeAll);
</script>
