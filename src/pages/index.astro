---
import BaseLayout from "../layouts/layout.astro";
import HeroHome from "../components/hero_home.astro";
import FitLanes from "../components/fit_lanes.astro";
import SectionDivider from "../components/section_divider.astro";
import SectionHead from "../components/section_head.astro";
import SecretTooltip from "../components/secret_tooltip.astro";
import CategorySwitcher from "../components/category_switcher.astro";
import WorkCard from "../components/work_card.astro";
import JourneyRow from "../components/journey_row.astro";
import SkillsGrid from "../components/skills_grid.astro";
import BookCall from "../components/book_call.astro";
import SiteFooter from "../components/site_footer.astro";
import { name, showcaseProjectIds, secrets } from "../data/resume";
import { getExperiences, getProjects } from "../data/content";

const projects = await getProjects();
const experiences = await getExperiences();

const visible = projects.filter((p) => !p.draft);
const showcase = showcaseProjectIds
  .map((id) => visible.find((p) => p.id === id))
  .filter((p) => p !== undefined);
const archive = visible.filter((p) => !showcaseProjectIds.includes(p.id));
---

<BaseLayout
  title={`${name} | Full-Stack Developer & Growth Marketer`}
  description="Full-stack developer (Flutter, Next.js) and growth marketer (4:1 ROAS, $355K campaign volume) in Davao, Philippines. 2 live SaaS products. Open to remote roles in SEA."
>
  <main id="main" class="wrap flex flex-col gap-8 sm:gap-10 pt-10 md:pt-16 pb-4">
    <HeroHome />

    <div data-reveal style="--i:1">
      <SectionDivider />
      <FitLanes />
    </div>

    <div data-reveal style="--i:2">
      <SectionDivider />
      <section id="work">
        <SectionHead
          title="Selected work"
          subtitle="Products, campaigns, and systems with measurable outcomes."
        />
        <div class="mt-6"><CategorySwitcher /></div>
        <div class="mt-6 work-strip" data-project-grid>
          {
            showcase.map((p, i) => (
              <WorkCard {...p} index={i} featured={true} />
            ))
          }
          {
            archive.map((p, i) => (
              <WorkCard {...p} index={i + showcase.length} />
            ))
          }
        </div>
      </section>
    </div>

    <div data-reveal style="--i:3">
      <SectionDivider />
      <section id="experience">
        <SectionHead
          title="Experience"
          subtitle="Professional progression across engineering and growth."
        />
        <div class="mt-6">
          <CategorySwitcher
            targetSelector="[data-experience-list]"
            itemSelector="[data-experience-row]"
            storageKey="experience-category"
            categories={[
              { id: "all", label: "All" },
              { id: "software", label: "Software" },
              { id: "marketing", label: "Growth Marketing" },
            ]}
          />
        </div>
        <div class="mt-4 timeline" data-experience-list>
          {
            experiences.map((exp) => (
              <div data-experience-row data-category={exp.category}>
                <JourneyRow {...exp} />
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <div data-reveal style="--i:4">
      <SectionDivider />
      <SkillsGrid />
    </div>

    <div data-reveal style="--i:5">
      <SectionDivider />
      <section id="contact">
        <p class="eyebrow">
          <SecretTooltip
            trigger={secrets.status.trigger}
            reveal={secrets.status.reveal}
          />
        </p>
        <div class="mt-3">
          <BookCall
            defaultInterest="hybrid"
            title="Let's talk"
            subtitle="Send a short note or book a time. Replies within 24–48 hours."
          />
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  import { ready } from "../scripts/ready";

  const syncFeaturedOpen = () => {
    const desktop = window.matchMedia("(min-width: 640px)").matches;
    document
      .querySelectorAll<HTMLElement>(".work-strip > .work-card[data-featured='true']")
      .forEach((c) => {
        if (desktop) c.setAttribute("open", "");
        else c.removeAttribute("open");
      });
  };

  let wasDesktop = window.matchMedia("(min-width: 640px)").matches;

  ready(syncFeaturedOpen);

  window.addEventListener("resize", () => {
    const isDesktop = window.matchMedia("(min-width: 640px)").matches;
    if (isDesktop === wasDesktop) return;
    wasDesktop = isDesktop;
    syncFeaturedOpen();
  });
</script>
