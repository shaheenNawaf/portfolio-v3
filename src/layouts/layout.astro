---
import "../styles/global.css";
import themeInit from "../scripts/theme-init.js?raw";
import SiteSidebar from "../components/site_sidebar.astro";

interface Props {
  title: string;
  description?: string;
  /** Visual biome: hub (dual), software (lab), marketing (studio) */
  track?: "hub" | "software" | "marketing";
}

const {
  title,
  description = "Full-stack Software Engineer & Growth Marketer based in Davao, Philippines. Remote-first SEA. Book an intro call.",
  track = "hub",
} = Astro.props;

const siteUrl = "https://shaheen.works";
const ogImage = `${siteUrl}/thumbnail.png`;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<html lang="en" class="antialiased" data-track={track}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script is:inline set:html={themeInit} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png?v=2"
    />

    <link rel="canonical" href={canonicalURL} />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfbfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#272629" media="(prefers-color-scheme: dark)" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Shaheen Aladwani" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
  </head>

  <body class="min-h-screen relative transition-colors duration-300">
    <SiteSidebar />
    <a href="#main" class="skip-link">Skip to content</a>

    <slot />

    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/rail.ts"></script>
    <script src="../scripts/tilt.ts"></script>
    <script src="../scripts/card-media.ts"></script>
    <script src="../scripts/count-up.ts"></script>
    <script src="../scripts/github-activity.ts"></script>
    <script src="../scripts/ui-sound.ts"></script>
    <script src="../scripts/portal.ts"></script>
  </body>
</html>
