---
import "../styles/global.css";
import themeInit from "../scripts/theme-init.js?raw";
import SiteSidebar from "../components/site_sidebar.astro";
import { contact, name as personName } from "../data/resume";

interface Props {
  title: string;
  description?: string;
  /** Visual biome: hub (dual), software (lab), marketing (studio) */
  track?: "hub" | "software" | "marketing";
  /** Set for pages that must not appear in search results (e.g. 404) */
  noindex?: boolean;
}

const {
  title,
  description = "Full-stack developer (Flutter, Next.js) and growth marketer (4:1 ROAS, $355K campaign volume) based in Davao, Philippines. Open to remote roles across SEA.",
  track = "hub",
  noindex = false,
} = Astro.props;

const siteUrl = "https://shaheen.works";
const siteName = `${personName} — Portfolio`;
const ogImage = `${siteUrl}/thumbnail.png`;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

/** Entity graph: who this site is about + the page itself. */
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      name: personName,
      url: siteUrl,
      image: `${siteUrl}/og-image.jpg`,
      jobTitle: "Full-Stack Software Engineer & Growth Marketer",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Davao",
        addressCountry: "PH",
      },
      sameAs: [`https://${contact.github}`, `https://${contact.linkedin}`],
      knowsAbout: [
        "Full-Stack Development",
        "Flutter",
        "Next.js",
        "TypeScript",
        "Spring Boot",
        "Supabase",
        "Growth Marketing",
        "Influencer Marketing",
        "Creator Partnerships",
        "Community Building",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: siteName,
      author: { "@id": `${siteUrl}/#person` },
      inLanguage: "en",
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalURL}#webpage`,
      url: String(canonicalURL),
      name: title,
      description,
      isPartOf: { "@id": `${siteUrl}/#website` },
      about: { "@id": `${siteUrl}/#person` },
      inLanguage: "en",
    },
  ],
};
---

<html lang="en" class="antialiased" data-track={track}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script is:inline set:html={themeInit} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png?v=2"
    />

    <link rel="canonical" href={canonicalURL} />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfbfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#272629" media="(prefers-color-scheme: dark)" />

    <link
      rel="preload"
      href="/fonts/Geist-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/GeistMono-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="author" content="Shaheen Aladwani" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Shaheen Al Adwani — Full-Stack Developer & Growth Marketer"
    />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    <meta
      property="twitter:image:alt"
      content="Shaheen Al Adwani — Full-Stack Developer & Growth Marketer"
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </head>

  <body class="min-h-screen relative transition-colors duration-300">
    <SiteSidebar />
    <a href="#main" class="skip-link">Skip to content</a>

    <slot />

    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/rail.ts"></script>
    <script src="../scripts/tilt.ts"></script>
    <script src="../scripts/card-media.ts"></script>
    <script src="../scripts/count-up.ts"></script>
    <script src="../scripts/github-activity.ts"></script>
    <script src="../scripts/ui-sound.ts"></script>
    <script src="../scripts/portal.ts"></script>
  </body>
</html>
