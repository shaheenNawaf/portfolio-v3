---
import { name, socials } from "../data/resume";
import StickerPill from "./sticker_pill.astro";
---

<footer class="mt-8 sm:mt-10 border-t hairline">
  <div class="wrap flex flex-col gap-5 pt-6 pb-24 lg:pb-10">
    <nav class="flex flex-wrap items-center gap-1.5" aria-label="Footer">
      {socials.map((s) => <StickerPill social={s} idPrefix="foot-" />)}
    </nav>
    <div
      class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-[12px]"
    >
      <span class="faint">© {new Date().getFullYear()} {name}</span>
      <span
        id="heart-trigger"
        class="font-mono text-[10px] font-bold faint uppercase tracking-widest cursor-pointer hover:text-red-500 transition-colors"
        role="button"
        tabindex="0"
        aria-label="Easter egg"
        >made with ❤ -shaheen</span
      >
    </div>
  </div>
</footer>
