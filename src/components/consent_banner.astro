<div
  id="consent-banner"
  hidden
  role="dialog"
  aria-label="Storage preferences"
  class="fixed left-1/2 -translate-x-1/2 bottom-20 lg:bottom-4 z-30 w-[min(92vw,40rem)] rounded-[var(--radius)] border hairline bg-[color:var(--bg)] p-4 shadow-[0_6px_16px_-4px_rgb(0_0_0/0.08)]"
>
  <p class="text-[12px] muted leading-[1.6]">
    This site stores a few preferences in your browser (theme, sound, filters) —
    no cookies, no analytics, no tracking.
    <a href="/privacy" class="fg font-medium hover:opacity-70 transition-opacity">Privacy policy</a>.
  </p>
  <div class="mt-3 flex flex-wrap items-center gap-2">
    <button
      type="button"
      id="consent-allow"
      class="px-3 py-1 rounded-full bg-[color:var(--text)] text-[color:var(--bg)] text-[12px] font-semibold transition-transform active:translate-y-px"
    >
      Allow preferences
    </button>
    <button
      type="button"
      id="consent-essential"
      class="px-3 py-1 rounded-full border hairline text-[12px] font-medium muted transition-colors hover:text-[color:var(--text)]"
    >
      Essential only
    </button>
  </div>
</div>

<script>
  const KEY = "consent";
  const banner = document.getElementById("consent-banner");

  const show = () => banner?.removeAttribute("hidden");
  const hide = () => banner?.setAttribute("hidden", "");

  const stored = () => {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  };

  if (stored() === null) show();

  document.getElementById("consent-allow")?.addEventListener("click", () => {
    try {
      localStorage.setItem(KEY, "all");
    } catch {}
    hide();
  });

  document.getElementById("consent-essential")?.addEventListener("click", () => {
    try {
      localStorage.setItem(KEY, "essential");
    } catch {}
    hide();
  });

  document.querySelectorAll("[data-consent-open]").forEach((el) => {
    el.addEventListener("click", () => show());
  });
</script>