---
import type { Stat } from "../data/resume";
import Icon from "./icon.astro";

interface Props {
  stat: Stat;
}

const { stat } = Astro.props;
---

<div class="group/stat flex flex-col gap-1 rounded-[var(--radius)]" tabindex="0">
  <span
    class="stat-number text-[24px] sm:text-[28px] font-semibold tracking-[-0.02em] leading-[1.15] fg"
    data-count-to={stat.num}
    data-count-prefix={stat.prefix}
    data-count-suffix={stat.suffix}
  >
    {stat.value}
  </span>
  <span class="flex items-start gap-1.5 text-[12px] muted leading-snug">
    <span
      class="mt-[5px] w-1.5 h-1.5 rounded-full shrink-0"
      style={`background-color: var(--${stat.lane})`}
      aria-hidden="true"
    ></span>
    {stat.label}
    <Icon
      name="chevron-down"
      class="stat-chevron row-chevron mt-[2px] w-3 h-3 shrink-0 group-hover/stat:rotate-180"
    />
  </span>
  <div
    class="stat-sub grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-300 ease-out group-hover/stat:grid-rows-[1fr] group-hover/stat:opacity-100 group-focus-visible/stat:grid-rows-[1fr] group-focus-visible/stat:opacity-100"
  >
    <p class="overflow-hidden text-[11px] faint leading-[1.45] pt-0.5">{stat.sub}</p>
  </div>
</div>
