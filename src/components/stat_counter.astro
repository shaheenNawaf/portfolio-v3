---
import type { Stat } from "../data/resume";

interface Props {
  stat: Stat;
}

const { stat } = Astro.props;
---

<div class="flex flex-col gap-1">
  <span
    class="stat-number text-lg font-bold fg"
    data-count-to={stat.num}
    data-count-prefix={stat.prefix}
    data-count-suffix={stat.suffix}
  >
    {stat.value}
  </span>
  <span class="text-[12px] muted leading-snug">{stat.label}</span>
</div>
