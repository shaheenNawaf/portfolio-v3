---
import {
  name,
  contact,
  hub,
  hubStats,
  socials,
  secrets,
  swaps,
} from "../data/resume";
import VerifiedBadge from "./verified_badge.astro";
import SecretSwap from "./secret_swap.astro";
import SecretTooltip from "./secret_tooltip.astro";
import StickerPill from "./sticker_pill.astro";
import StatCounter from "./stat_counter.astro";
import ActivityHeatmap from "./activity_heatmap.astro";

const subtextParts = hub.subtext.split(secrets.roas.trigger);
---

<section id="hero" class="pt-2" data-reveal="hero" style="--i:0">
  <div class="flex items-center gap-3 leading-relaxed">
    <button
      type="button"
      id="avatar-egg"
      aria-label={`${name} profile picture`}
      data-ui-sound="none"
      class="relative w-12 h-12 shrink-0 cursor-default overflow-hidden rounded-full"
    >
      <img
        src={contact.profileImage}
        alt=""
        width="48"
        height="48"
        class="w-full h-full object-cover"
        loading="eager"
      />
      <span
        aria-hidden="true"
        id="avatar-shades"
        class="absolute top-[38%] left-1/2 flex -translate-x-1/2 items-center opacity-0 transition-opacity duration-150"
      >
        <span
          class="h-2.5 w-4 bg-black [clip-path:polygon(0_0,100%_0,88%_100%,22%_100%)]"
        ></span>
        <span class="h-0.5 w-1 bg-black"></span>
        <span
          class="h-2.5 w-4 bg-black [clip-path:polygon(0_0,100%_0,78%_100%,12%_100%)]"
        ></span>
      </span>
    </button>
    <div class="flex flex-col min-w-0">
      <h1
        id="hero-name"
        class="flex items-center gap-1 text-[22px] md:text-[26px] font-medium tracking-[-0.01em] leading-[1.2]"
      >
        {name}
        <VerifiedBadge />
      </h1>
      <span class="muted">
        <SecretSwap from={swaps.position.from} to={swaps.position.to} />
      </span>
    </div>
  </div>

  <p class="mt-6 text-[15px] muted leading-[1.7] max-w-[52ch]">
    {
      subtextParts.map((part, i) => (
        <span>
          {part}
          {i < subtextParts.length - 1 && (
            <SecretTooltip trigger={secrets.roas.trigger} reveal={secrets.roas.reveal} />
          )}
        </span>
      ))
    }
  </p>

  <p class="mt-4 text-[15px] muted leading-[1.9] max-w-[56ch]">
    You can find me <ActivityHeatmap phrase="shipping" /> on{" "}
    <StickerPill social={socials[0]} idPrefix="hero-" />, hiring-side on{" "}
    <StickerPill social={socials[1]} idPrefix="hero-" />, or reach me at{" "}
    <StickerPill social={socials[2]} idPrefix="hero-" />.
  </p>

  <p class="mt-4 text-[13px]">
    <SecretTooltip
      trigger={secrets.location.trigger}
      reveal={secrets.location.reveal}
    />
  </p>

  <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 text-[13px]">
    <a
      href="#contact"
      data-ui-sound="crisp"
      class="font-semibold fg hover:opacity-70 transition-opacity"
    >
      {hub.ctaPrimary} →
    </a>
    <StickerPill social={socials[3]} idPrefix="hero-" />
    <StickerPill social={socials[4]} idPrefix="hero-" />
  </div>

  <div
    class="mt-10 pt-6 border-t hairline grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-6"
  >
    {hubStats.map((s) => <StatCounter stat={s} />)}
  </div>
</section>

<script>
  document.getElementById("avatar-egg")?.addEventListener("click", () => {
    document.getElementById("avatar-shades")?.classList.toggle("opacity-100");
  });
</script>
