---
import { skillGroups } from "../data/resume";

const eng = skillGroups.engineering;
const mkt = skillGroups.marketing;
---

<section id="skills">
  <h2 class="text-[15px] font-semibold tracking-tight">Skills</h2>
  <div class="mt-6 grid gap-8 sm:grid-cols-2 sm:gap-10">
    <div>
      <p class="eyebrow mb-4">Engineering</p>
      <div class="space-y-3">
        {
          Object.entries(eng).map(([label, items]) => (
            <p class="text-[14px] leading-relaxed">
              <span class="fg font-semibold">{label}:</span>{" "}
              <span class="muted">{items.join(", ")}</span>
            </p>
          ))
        }
      </div>
    </div>
    <div>
      <p class="eyebrow mb-4">Marketing</p>
      <div class="space-y-3">
        {
          Object.entries(mkt).map(([label, items]) => (
            <p class="text-[14px] leading-relaxed">
              <span class="fg font-semibold">{label}:</span>{" "}
              <span class="muted">{items.join(", ")}</span>
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>
