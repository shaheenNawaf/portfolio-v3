---
interface Props {
  from: string;
  to: string;
}

const { from, to } = Astro.props;
---

<span class="group/swap inline-grid items-baseline">
  <span
    class="col-start-1 row-start-1 transition-[opacity,transform,filter] duration-200 group-hover/swap:-translate-y-1 group-hover/swap:opacity-0 group-hover/swap:blur-[2px] motion-reduce:transition-none"
  >
    {from}
  </span>
  <span
    aria-hidden="true"
    class="col-start-1 row-start-1 translate-y-1 opacity-0 blur-[2px] transition-[opacity,transform,filter] duration-200 group-hover/swap:translate-y-0 group-hover/swap:opacity-100 group-hover/swap:blur-none motion-reduce:transition-none"
  >
    {to}
  </span>
</span>
