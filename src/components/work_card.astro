---
import type { Category } from "../data/resume";
import Icon from "./icon.astro";

interface Props {
  id: string;
  title: string;
  category: Category;
  description: string;
  date?: string;
  role?: string;
  results?: string;
  impact?: string;
  problem?: string;
  solution?: string;
  tags?: readonly string[];
  deliverables?: readonly string[];
  media?: { type: "video" | "image"; url: string; thumbnail?: string };
  gallery?: readonly string[];
  liveUrl?: string;
  repoUrl?: string;
  caseStudyHref?: string;
  index?: number;
  featured?: boolean;
}

const {
  id,
  title,
  category,
  description,
  date,
  role,
  results,
  impact,
  problem,
  solution,
  tags = [],
  deliverables = [],
  media,
  gallery = [],
  liveUrl,
  repoUrl,
  caseStudyHref,
  index = 0,
  featured = false,
} = Astro.props;

const thumb =
  media?.type === "video"
    ? media.thumbnail ?? undefined
    : media?.url ?? gallery[0];
const metric = results ?? impact;
const hasDepth = Boolean(
  problem || solution || impact || gallery.length > 0 || media,
);
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const showCaseStudy = Boolean(caseStudyHref) && caseStudyHref !== currentPath;
const linkHref =
  liveUrl && liveUrl.length > 0
    ? liveUrl
    : repoUrl && repoUrl.length > 0
      ? repoUrl
      : showCaseStudy
        ? caseStudyHref
        : undefined;
const domainLabel =
  liveUrl && liveUrl.length > 0
    ? new URL(liveUrl).hostname.replace(/^www\./, "")
    : "";
const categoryLabel =
  category === "marketing"
    ? "Growth"
    : category === "software"
      ? "Software"
      : "Systems";
const accentVar =
  category === "marketing"
    ? "var(--mkt)"
    : category === "software"
      ? "var(--sw)"
      : "var(--text)";
const initials = title
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w.charAt(0))
  .join("");
const listItems = category === "marketing" ? deliverables : tags;
const frameClass =
  "card-media relative aspect-video w-full overflow-hidden rounded-[var(--radius)] border bg-[color:var(--surface)]";
const outerAttrs = {
  "class": "work-card group/preview",
  "data-project-card": id,
  "data-category": category,
  "data-featured": featured ? "true" : "false",
  "data-reveal": true,
  "style": `--i:${index}; --card-accent:${accentVar}`,
};
---

{
  hasDepth ? (
    <details {...outerAttrs}>
      <summary data-ui-sound="crisp">
        <div class:list={[frameClass, { "is-loaded": !thumb }]}>
          <div class="card-pulse" aria-hidden="true" />
          {thumb ? (
            <img
              src={thumb}
              alt={`${title} preview`}
              loading="lazy"
              decoding="async"
              data-fade
              class="card-thumb h-full w-full object-cover"
            />
          ) : (
            <div class="absolute inset-0 grid place-items-center text-sm font-semibold faint">
              {initials}
            </div>
          )}
        </div>

        <div class="card-caption">
          <h3 class="card-title">{title}</h3>
          <p class="card-metric">{metric ?? description}</p>
          <div class="card-chips">
            <span class="card-chip">{categoryLabel}</span>
            {domainLabel && <span class="card-chip">{domainLabel}</span>}
            <Icon name="chevron-down" class="row-chevron w-3.5 h-3.5 faint" />
          </div>
        </div>
      </summary>

      <div class="card-body">
        {role && (
          <p class="max-w-[68ch] text-[12px] faint">
            {role}
            {date ? ` · ${date}` : ""}
          </p>
        )}

        {problem || solution || impact ? (
          <div class="flex max-w-[68ch] flex-col gap-4">
            {problem && (
              <div>
                <p class="eyebrow mb-1">Problem</p>
                <p class="muted leading-[1.7]">{problem}</p>
              </div>
            )}
            {solution && (
              <div>
                <p class="eyebrow mb-1">Solution</p>
                <p class="muted leading-[1.7]">{solution}</p>
              </div>
            )}
            {impact && (
              <div>
                <p class="eyebrow mb-1">Impact</p>
                <p class="muted leading-[1.7]">{impact}</p>
              </div>
            )}
          </div>
        ) : (
          <p class="max-w-[68ch] muted leading-[1.7]">{description}</p>
        )}

        {listItems.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {listItems.slice(0, 8).map((item: string) => (
              <span class="card-chip">{item}</span>
            ))}
          </div>
        )}

        {media?.type === "video" && (
          <video
            src={media.url}
            poster={media.thumbnail}
            controls
            class="w-full rounded-[var(--radius)] border hairline"
          />
        )}

        {gallery.length > 0 && (
          <div class="card-gallery">
            {gallery.map((g, gi) => (
              <img
                src={g}
                alt={`${title} — image ${gi + 1} of ${gallery.length}`}
                loading="lazy"
                decoding="async"
              />
            ))}
          </div>
        )}

        {(liveUrl || repoUrl || showCaseStudy) && (
          <div class="card-links">
            {liveUrl && liveUrl.length > 0 && (
              <a
                href={liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                style={`color: ${accentVar}`}
              >
                Live ↗
              </a>
            )}
            {repoUrl && repoUrl.length > 0 && (
              <a
                href={repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                style={`color: ${accentVar}`}
              >
                GitHub ↗
              </a>
            )}
            {showCaseStudy && (
              <a
                href={caseStudyHref}
                style={`color: ${accentVar}`}
              >
                Case study ↗
              </a>
            )}
          </div>
        )}
      </div>
    </details>
  ) : (
    <div {...outerAttrs}>
      <div class:list={[frameClass, "is-loaded"]}>
        <div class="absolute inset-0 grid place-items-center text-sm font-semibold faint">
          {initials}
        </div>
      </div>
      <div class="card-caption">
        <h3 class="card-title">{title}</h3>
        <p class="card-metric">{metric ?? description}</p>
        <div class="card-chips">
          <span class="card-chip">{categoryLabel}</span>
          {linkHref && (
            <a
              href={linkHref}
              target="_blank"
              rel="noopener noreferrer"
              class="card-chip transition-transform duration-150 motion-reduce:transition-none hover:-translate-y-0.5 active:translate-y-px motion-reduce:hover:translate-y-0 motion-reduce:active:translate-y-0"
            >
              {domainLabel || categoryLabel} ↗
            </a>
          )}
        </div>
      </div>
    </div>
  )
}
