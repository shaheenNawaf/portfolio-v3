---
import { DitherGradient } from "./dither-kit/gradient";
import { hubStats } from "../data/resume";

const swStat = hubStats[4];
const mktVolume = hubStats[0];
const mktRoas = hubStats[3];
---

<!-- ═══════════════════════════════════════════════════════════════════════════
     TRACK FORK — recruiter routing
     One split panel, two tracks. Hover expands a side toward the seam.
     ═══════════════════════════════════════════════════════════════════════════ -->
<section id="tracks" class="relative py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-5 md:px-8">
    <div class="mb-8 md:mb-12 reveal-section">
      <p
        class="text-[12px] font-mono uppercase tracking-widest text-[color:var(--accent)]"
      >
        Open to both tracks
      </p>
      <h2
        class="mt-3 text-3xl md:text-4xl font-bold text-[color:var(--text)] tracking-tight"
      >
        Which seat are you hiring for?
      </h2>
      <p class="muted text-base md:text-lg mt-3 max-w-2xl">
        One owner, end to end. Pick the track that matches your opening — or
        book a call about both.
      </p>
    </div>

    <div
      class="reveal-section relative flex flex-col md:flex-row panel radius-card border border-[color:var(--border)] overflow-hidden"
    >
      <!-- Engineering side -->
      <a
        href="/software"
        aria-label="Engineering track — see the software engineer portfolio"
        class="fork-side group min-h-[240px] md:min-h-[380px] p-7 md:p-10 flex flex-col justify-between gap-8"
        style="--side-color: var(--sw);"
      >
        <DitherGradient
          client:load
          from="blue"
          to="transparent"
          direction="left"
          cell={4}
          opacity={0.4}
        />

        <div class="relative">
          <p
            class="text-[11px] font-mono font-bold uppercase tracking-[0.2em]"
            style="color: var(--sw);"
          >
            Track 01 — Engineering
          </p>
          <h3
            class="mt-3 text-2xl md:text-3xl font-bold text-[color:var(--text)] tracking-tight"
          >
            Software Engineer
          </h3>
        </div>

        <div class="relative flex flex-col gap-4">
          <div class="flex items-baseline gap-3">
            <span
              class="text-3xl md:text-4xl font-bold tracking-tight shrink-0"
              style="color: var(--sw);"
            >
              {swStat.value}
            </span>
            <span class="muted text-sm leading-snug">
              {swStat.label.toLowerCase()} in paid beta
            </span>
          </div>
          <div class="flex items-baseline gap-3">
            <span
              class="text-3xl md:text-4xl font-bold tracking-tight shrink-0"
              style="color: var(--sw);"
            >
              DL
            </span>
            <span class="muted text-sm leading-snug">
              Dean's List · Ateneo de Davao — while shipping full-time
            </span>
          </div>
        </div>

        <span class="fork-go relative inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.15em]">
          See the engineering work
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </span>
      </a>

      <!-- Seam -->
      <div class="fork-seam shrink-0 h-px w-full md:h-auto md:w-px" aria-hidden="true">
      </div>

      <!-- Marketing side -->
      <a
        href="/marketing"
        aria-label="Marketing track — see the growth marketer portfolio"
        class="fork-side group min-h-[240px] md:min-h-[380px] p-7 md:p-10 flex flex-col justify-between gap-8"
        style="--side-color: var(--mkt);"
      >
        <DitherGradient
          client:load
          from="orange"
          to="transparent"
          direction="right"
          cell={4}
          opacity={0.4}
        />

        <div class="relative">
          <p
            class="text-[11px] font-mono font-bold uppercase tracking-[0.2em]"
            style="color: var(--mkt);"
          >
            Track 02 — Growth
          </p>
          <h3
            class="mt-3 text-2xl md:text-3xl font-bold text-[color:var(--text)] tracking-tight"
          >
            Growth Marketer
          </h3>
        </div>

        <div class="relative flex flex-col gap-4">
          <div class="flex items-baseline gap-3">
            <span
              class="text-3xl md:text-4xl font-bold tracking-tight shrink-0"
              style="color: var(--mkt);"
            >
              {mktVolume.value}
            </span>
            <span class="muted text-sm leading-snug">
              transaction volume in 4 months
            </span>
          </div>
          <div class="flex items-baseline gap-3">
            <span
              class="text-3xl md:text-4xl font-bold tracking-tight shrink-0"
              style="color: var(--mkt);"
            >
              {mktRoas.value}
            </span>
            <span class="muted text-sm leading-snug">
              {mktRoas.label.toLowerCase()} across every creator onboarded
            </span>
          </div>
        </div>

        <span class="fork-go relative inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.15em]">
          See the marketing work
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </span>
      </a>

      <!-- Hand-drawn note on the seam -->
      <div
        class="absolute inset-0 flex items-center justify-center pointer-events-none z-10"
        aria-hidden="true"
      >
        <span class="fork-note" style="font-family: 'Caveat', cursive; transform: rotate(-3deg);">
          pick a lane — or don't
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .fork-side {
    position: relative;
    flex: 1 1 0%;
    text-decoration: none;
    transition:
      flex-grow 550ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 300ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .fork-side:hover {
      flex-grow: 1.4;
    }
  }

  .fork-side:focus-visible {
    outline: 2px solid var(--side-color);
    outline-offset: -3px;
  }

  .fork-side::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms ease;
    background: radial-gradient(
      90% 90% at 50% 100%,
      color-mix(in srgb, var(--side-color) 10%, transparent),
      transparent 70%
    );
  }
  .fork-side:hover::after,
  .fork-side:focus-visible::after {
    opacity: 1;
  }

  .fork-go {
    color: var(--text-muted);
    transition: color 200ms ease;
  }
  .fork-go svg {
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .fork-side:hover .fork-go,
  .fork-side:focus-visible .fork-go {
    color: var(--side-color);
  }
  .fork-side:hover .fork-go svg,
  .fork-side:focus-visible .fork-go svg {
    transform: translateX(4px);
  }

  .fork-seam {
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--mkt) 65%, transparent),
      color-mix(in srgb, var(--sw) 65%, transparent),
      transparent
    );
    box-shadow: 0 0 20px color-mix(in srgb, var(--accent) 20%, transparent);
  }
  @media (min-width: 48rem) {
    .fork-seam {
      background: linear-gradient(
        180deg,
        transparent,
        color-mix(in srgb, var(--sw) 65%, transparent) 30%,
        color-mix(in srgb, var(--mkt) 65%, transparent) 70%,
        transparent
      );
    }
  }

  .fork-note {
    font-size: 19px;
    line-height: 1;
    white-space: nowrap;
    color: var(--text-muted);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 16px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 4px 16px -6px rgba(0, 0, 0, 0.35);
  }

  @media (prefers-reduced-motion: reduce) {
    .fork-side,
    .fork-side::after,
    .fork-go,
    .fork-go svg {
      transition: none !important;
    }
  }
</style>
