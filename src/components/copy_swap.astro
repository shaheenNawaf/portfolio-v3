---
/**
 * Click-to-copy text with a blur-crossfade hint (same motion as SecretSwap):
 * `value` rests visible, `hint` replaces it on hover/focus, and a click copies
 * `value` and briefly confirms.
 */
interface Props {
  value: string;
  hint: string;
  copied?: string;
}

const { value, hint, copied = "copied — talk soon ✓" } = Astro.props;

const layer =
  "col-start-1 row-start-1 whitespace-nowrap transition-[opacity,transform,filter] duration-200 motion-reduce:transition-none";
---

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-swap]").forEach((btn) => {
    const hint = btn.querySelector<HTMLElement>("[data-copy-hint]");
    const status = btn.nextElementSibling as HTMLElement | null;
    const value = btn.querySelector<HTMLElement>("[data-copy-value]");
    const resting = hint?.textContent?.trim() ?? "";
    let timer = 0;

    // The underline tracks whichever text is showing: measure both layers.
    const measure = () => {
      if (value) btn.style.setProperty("--w-rest", `${value.offsetWidth}px`);
      if (hint) btn.style.setProperty("--w-hint", `${hint.offsetWidth}px`);
    };
    measure();
    void document.fonts?.ready.then(measure);
    window.addEventListener("resize", measure);

    btn.addEventListener("click", async () => {
      let msg = btn.dataset.copiedText ?? "copied";
      try {
        await navigator.clipboard.writeText(btn.dataset.copySwap ?? "");
      } catch {
        msg = "couldn't copy — select it instead";
      }
      if (hint) hint.textContent = msg;
      measure();
      if (status) status.textContent = msg;
      btn.dataset.copied = "true";
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.dataset.copied = "false";
        if (hint) hint.textContent = resting;
        measure();
        if (status) status.textContent = "";
      }, 1800);
    });
  });
</script>

<style>
  /* The button itself resizes to the visible text — email at rest, hint /
     confirmation on hover, focus or copied — so the sentence closes up
     around it. Widths are measured in JS; without JS it stays auto width. */
  [data-copy-swap] {
    width: var(--w-rest, auto);
    transition: width 0.22s var(--ease-out-expo);
  }
  [data-copy-swap]:hover,
  [data-copy-swap]:focus-visible,
  [data-copy-swap][data-copied="true"] {
    width: var(--w-hint, auto);
  }
  /* Invisible email-width hover area: once the box shrinks, a pointer near
     its old right edge is still "on" it, so hover can't flicker on/off. */
  [data-copy-swap]::after {
    content: ""; position: absolute; top: 0; bottom: 0; left: 0;
    width: var(--w-rest, 100%);
  }
  /* Dotted rule spans the (resizing) button. */
  .copy-rule {
    position: absolute; left: 0; right: 0; bottom: 0; height: 0;
    border-bottom: 1px dotted currentColor;
    transition: color 0.2s ease;
    pointer-events: none;
  }
  [data-copy-swap]:hover .copy-rule,
  [data-copy-swap]:focus-visible .copy-rule,
  [data-copy-swap][data-copied="true"] .copy-rule { color: var(--text-muted); }
  @media (prefers-reduced-motion: reduce) {
    [data-copy-swap] { transition: none; }
  }
</style>

<button
  type="button"
  data-copy-swap={value}
  data-copied-text={copied}
  aria-label={`Copy email address ${value}`}
  class="group/copy relative inline-grid max-w-full items-baseline justify-items-start text-left fg cursor-copy"
>
  <span
    data-copy-value
    class:list={[
      layer,
      "group-hover/copy:-translate-y-1 group-hover/copy:opacity-0 group-hover/copy:blur-[2px]",
      "group-focus-visible/copy:-translate-y-1 group-focus-visible/copy:opacity-0 group-focus-visible/copy:blur-[2px]",
      "group-data-[copied=true]/copy:-translate-y-1 group-data-[copied=true]/copy:opacity-0 group-data-[copied=true]/copy:blur-[2px]",
    ]}
  >
    {value}
  </span>
  <span
    aria-hidden="true"
    data-copy-hint
    class:list={[
      layer,
      "muted translate-y-1 opacity-0 blur-[2px]",
      "group-hover/copy:translate-y-0 group-hover/copy:opacity-100 group-hover/copy:blur-none",
      "group-focus-visible/copy:translate-y-0 group-focus-visible/copy:opacity-100 group-focus-visible/copy:blur-none",
      "group-data-[copied=true]/copy:translate-y-0 group-data-[copied=true]/copy:opacity-100 group-data-[copied=true]/copy:blur-none",
    ]}
  >
    {hint}
  </span>
  <span class="copy-rule" aria-hidden="true"></span>
</button><span class="sr-only" role="status" aria-live="polite" data-copy-status
></span>