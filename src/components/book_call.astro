---
import { contact, hub } from "../data/resume";
import SectionHead from "./section_head.astro";

interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  defaultInterest?: "hybrid" | "software" | "marketing";
  compact?: boolean;
}

const {
  id = "book-call",
  title = "Book a 15-min intro call",
  subtitle = "Short form first. Then pick a time on Google Appointments.",
  defaultInterest = "hybrid",
  compact = false,
} = Astro.props;

const appointmentUrl = hub.appointmentUrl?.trim() ?? "";
---

<section
  id={id}
  class="pt-2"
  data-appointment-url={appointmentUrl}
  data-contact-email={contact.email}
>
  <div class:list={["mb-6 md:mb-8 max-w-xl", { hidden: compact }]}>
    <SectionHead title={title} subtitle={subtitle} />
    <slot name="direct" />
  </div>

  <form
    id={`${id}-form`}
    name="book-call"
    method="POST"
    action="/api/contact"
    class="grid gap-4 md:grid-cols-2"
    novalidate
  >
    <p class="hidden" aria-hidden="true">
      <label
        >Don't fill this out if you're human: <input
          name="bot-field"
          tabindex="-1"
          autocomplete="off"
          class="book-field"
        /></label
      >
    </p>
    <div class="md:col-span-1">
      <label class="book-label" for={`${id}-name`}
        >Name <span aria-hidden="true" class="faint">*</span></label
      >
      <input
        id={`${id}-name`}
        name="name"
        type="text"
        required
        autocomplete="name"
        class="book-field"
        placeholder="Your name"
        aria-describedby={`${id}-name-error`}
      />
      <p id={`${id}-name-error`} class="book-error hidden" data-field-error></p>
    </div>

    <div class="md:col-span-1">
      <label class="book-label" for={`${id}-email`}
        >Work email <span aria-hidden="true" class="faint">*</span></label
      >
      <input
        id={`${id}-email`}
        name="email"
        type="email"
        required
        autocomplete="email"
        class="book-field"
        placeholder="you@company.com"
        aria-describedby={`${id}-email-error`}
      />
      <p id={`${id}-email-error`} class="book-error hidden" data-field-error></p>
    </div>

    <div class="md:col-span-2">
      <label class="book-label" for={`${id}-interest`}>Hiring for</label>
      <select id={`${id}-interest`} name="interest" class="book-field">
        <option value="hybrid" selected={defaultInterest === "hybrid"}
          >Hybrid / either track</option
        >
        <option value="software" selected={defaultInterest === "software"}
          >Software / product</option
        >
        <option value="marketing" selected={defaultInterest === "marketing"}
          >Growth / marketing</option
        >
      </select>
    </div>

    <div class="md:col-span-2">
      <label class="book-label" for={`${id}-note`}>Context (optional)</label>
      <textarea
        id={`${id}-note`}
        name="note"
        rows="3"
        class="book-field resize-y min-h-[80px]"
        placeholder="Role, team, timeline — anything useful"
      ></textarea>
    </div>

    <div
      class:list={[
        "md:col-span-2 flex flex-col gap-3 pt-1",
        { "sm:flex-row sm:items-center sm:gap-4": !compact },
      ]}
    >
      <button
        type="submit"
        id={`${id}-submit`}
        class:list={[
          "btn-primary gap-2 px-5 py-3 rounded-[var(--radius)] disabled:opacity-60 disabled:cursor-not-allowed",
          { "w-full": compact },
        ]}
      >
        <span class="btn-label">{hub.submitLabel}</span>
        <span aria-hidden="true" class="text-[15px] leading-none">→</span>
      </button>
      <p class="text-[11px] muted leading-snug max-w-xs">
        {
          appointmentUrl
            ? "Sends your note and opens my calendar in a new tab."
            : "Takes 30 seconds — I read every note."
        }
      </p>
    </div>

    <p
      id={`${id}-status`}
      class="md:col-span-2 text-sm muted hidden"
      role="status"
      aria-live="polite"
    >
    </p>
  </form>
  <p class="mt-3 text-[11px] faint">
    By sending a note you agree to the
    <a href="/privacy/" class="fg underline-offset-4 hover:underline">privacy policy</a>.
  </p>
</section>

<script>
  const bindBookForms = () => {
    document.querySelectorAll("section[id][data-contact-email]").forEach((section) => {
      const form = section.querySelector("form");
      if (!form || form.dataset.bound === "true") return;
      form.dataset.bound = "true";

      const status = section.querySelector("[role='status']") as HTMLElement | null;
      const appointmentUrl = (section as HTMLElement).dataset.appointmentUrl ?? "";
      const contactEmail = (section as HTMLElement).dataset.contactEmail ?? "";
      const submitBtn = form.querySelector("button[type='submit']") as HTMLButtonElement | null;
      const label = submitBtn?.querySelector(".btn-label") as HTMLElement | null;
      const idleLabel = label?.textContent ?? "Send message";

      /** Status line; optional mailto fallback link appended after the message. */
      const say = (msg: string, mailHref?: string) => {
        if (!status) return;
        status.classList.remove("hidden");
        status.textContent = msg;
        if (mailHref) {
          const a = document.createElement("a");
          a.href = mailHref;
          a.className = "fg underline underline-offset-2";
          a.textContent = `Email ${contactEmail} instead →`;
          status.append(" ", a);
        }
      };

      const setBusy = (busy: boolean) => {
        if (submitBtn) submitBtn.disabled = busy;
        if (label) label.textContent = busy ? "Sending…" : idleLabel;
      };

      const fieldError = (input: HTMLInputElement | null, msg: string) => {
        if (!input) return;
        const err = document.getElementById(input.getAttribute("aria-describedby") ?? "");
        input.setAttribute("aria-invalid", msg ? "true" : "false");
        if (err) {
          err.textContent = msg;
          err.classList.toggle("hidden", !msg);
        }
      };

      const mailDraft = (name: string, email: string, interest: string, note: string) => {
        const subject = encodeURIComponent(`Portfolio enquiry - ${interest} - ${name}`);
        const body = encodeURIComponent(
          [`Name: ${name}`, `Email: ${email}`, `Hiring for: ${interest}`, note ? `Note: ${note}` : null]
            .filter(Boolean)
            .join("\n"),
        );
        return `mailto:${contactEmail}?subject=${subject}&body=${body}`;
      };

      const nameInput = form.querySelector<HTMLInputElement>("input[name='name']");
      const emailInput = form.querySelector<HTMLInputElement>("input[name='email']");
      nameInput?.addEventListener("input", () => fieldError(nameInput, ""));
      emailInput?.addEventListener("input", () => fieldError(emailInput, ""));

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const name = String(data.get("name") ?? "").trim();
        const email = String(data.get("email") ?? "").trim();
        const interest = String(data.get("interest") ?? "hybrid");
        const note = String(data.get("note") ?? "").trim();

        const nameMsg = name ? "" : "Please add your name.";
        const emailMsg = !email
          ? "Please add your work email."
          : /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)
            ? ""
            : "That email doesn't look right.";
        fieldError(nameInput, nameMsg);
        fieldError(emailInput, emailMsg);
        if (nameMsg || emailMsg) {
          (nameMsg ? nameInput : emailInput)?.focus();
          return;
        }

        setBusy(true);
        say("Sending…");
        // Open the calendar synchronously inside the click; after the await,
        // popup blockers would stop it.
        if (appointmentUrl) window.open(appointmentUrl, "_blank", "noopener,noreferrer");

        const encoded = new URLSearchParams();
        data.forEach((value, key) => encoded.append(key, String(value)));

        fetch("/api/contact", {
          method: "POST",
          headers: {
            "Content-Type": "application/x-www-form-urlencoded",
            Accept: "application/json",
          },
          body: encoded.toString(),
        })
          .then(async (res) => {
            setBusy(false);
            if (res.ok) {
              form.reset();
              say(
                appointmentUrl
                  ? "Note sent. Pick a slot in the calendar tab to lock it in."
                  : "Sent. I reply within 24–48 hours.",
              );
              return;
            }
            if (res.status >= 400 && res.status < 500) {
              // The server rejected the input — show its reason, keep the form filled.
              const body = (await res.json().catch(() => null)) as { error?: string } | null;
              say(body?.error ? `${body.error}.` : "Something in the form needs another look.");
              return;
            }
            say(
              "Delivery failed on my end — your note wasn't sent.",
              mailDraft(name, email, interest, note),
            );
          })
          .catch(() => {
            // Offline or blocked: nothing reached the server.
            setBusy(false);
            say("Couldn't reach the form service.", mailDraft(name, email, interest, note));
          });
      });
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bindBookForms);
  } else {
    bindBookForms();
  }
</script>
