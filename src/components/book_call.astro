---
import { contact, hub } from "../data/resume";

interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  defaultInterest?: "hybrid" | "software" | "marketing";
  compact?: boolean;
}

const {
  id = "book-call",
  title = "Book a 15-min intro call",
  subtitle = "Short form first. Then pick a time on Google Appointments.",
  defaultInterest = "hybrid",
  compact = false,
} = Astro.props;

const appointmentUrl = hub.appointmentUrl?.trim() ?? "";
---

<section
  id={id}
  class="pt-2"
  data-appointment-url={appointmentUrl}
  data-contact-email={contact.email}
>
  <div class:list={["mb-6 md:mb-8 max-w-xl", { hidden: compact }]}>
    <h2 class="text-[15px] font-semibold tracking-tight">{title}</h2>
    <p class="mt-2 muted text-[13px] leading-relaxed max-w-prose">
      {subtitle}
    </p>
  </div>

  <form
    id={`${id}-form`}
    name="book-call"
    method="POST"
    data-netlify="true"
    data-netlify-honeypot="bot-field"
    class="grid gap-4 md:grid-cols-2"
    novalidate
  >
    <input type="hidden" name="form-name" value="book-call" />
    <p class="hidden" aria-hidden="true">
      <label
        >Don't fill this out if you're human: <input
          name="bot-field"
          tabindex="-1"
          autocomplete="off"
          class="book-field"
        /></label
      >
    </p>
    <div class="md:col-span-1">
      <label class="book-label" for={`${id}-name`}>Name</label>
      <input
        id={`${id}-name`}
        name="name"
        type="text"
        required
        autocomplete="name"
        class="book-field"
        placeholder="Your name"
      />
    </div>

    <div class="md:col-span-1">
      <label class="book-label" for={`${id}-email`}>Work email</label>
      <input
        id={`${id}-email`}
        name="email"
        type="email"
        required
        autocomplete="email"
        class="book-field"
        placeholder="you@company.com"
      />
    </div>

    <div class="md:col-span-2">
      <label class="book-label" for={`${id}-interest`}>Hiring for</label>
      <select id={`${id}-interest`} name="interest" class="book-field" required>
        <option value="hybrid" selected={defaultInterest === "hybrid"}
          >Hybrid / either track</option
        >
        <option value="software" selected={defaultInterest === "software"}
          >Software / product</option
        >
        <option value="marketing" selected={defaultInterest === "marketing"}
          >Growth / marketing</option
        >
      </select>
    </div>

    <div class="md:col-span-2">
      <label class="book-label" for={`${id}-note`}>Context (optional)</label>
      <textarea
        id={`${id}-note`}
        name="note"
        rows="3"
        class="book-field resize-y min-h-[80px]"
        placeholder="Role, timeline, or anything useful before the call"
      ></textarea>
    </div>

    <div
      class:list={[
        "md:col-span-2 flex flex-col gap-3 pt-1",
        { "sm:flex-row sm:items-center sm:gap-4": !compact },
      ]}
    >
      <button
        type="submit"
        id={`${id}-submit`}
        class:list={[
          "inline-flex items-center gap-2 px-5 py-2.5 rounded-[var(--radius)] border hairline text-[13px] font-semibold fg hover:border-[color:var(--border-strong)] transition-colors disabled:opacity-60 disabled:cursor-not-allowed",
          { "w-full": compact },
        ]}
      >
        <span class="btn-label">{hub.ctaPrimary}</span>
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
      <p class="text-[11px] muted leading-snug max-w-xs">
        {
          appointmentUrl
            ? "Sends your note, then opens Google Appointments to pick a time."
            : "Sends directly — I reply within 24–48 hours."
        }
      </p>
    </div>

    <p
      id={`${id}-status`}
      class="md:col-span-2 text-sm muted hidden"
      role="status"
      aria-live="polite"
    >
    </p>
  </form>
</section>

<script>
  const bindBookForms = () => {
    document.querySelectorAll("section[id][data-contact-email]").forEach((section) => {
      const form = section.querySelector("form");
      if (!form || form.dataset.bound === "true") return;
      form.dataset.bound = "true";

      const status = section.querySelector("[role='status']") as HTMLElement | null;
      const appointmentUrl = (section as HTMLElement).dataset.appointmentUrl ?? "";
      const contactEmail = (section as HTMLElement).dataset.contactEmail ?? "";
      const submitBtn = form.querySelector("button[type='submit']") as HTMLButtonElement | null;
      const label = submitBtn?.querySelector(".btn-label") as HTMLElement | null;
      const idleLabel = label?.textContent ?? "Book a Call";

      const say = (msg: string) => {
        if (status) {
          status.classList.remove("hidden");
          status.textContent = msg;
        }
      };

      const setBusy = (busy: boolean) => {
        if (submitBtn) submitBtn.disabled = busy;
        if (label) label.textContent = busy ? "Sending..." : idleLabel;
      };

      const openMailDraft = (name: string, email: string, interest: string, note: string) => {
        const subject = encodeURIComponent(
          `Intro call request - ${interest} - ${name}`,
        );
        const body = encodeURIComponent(
          [
            `Name: ${name}`,
            `Email: ${email}`,
            `Interest: ${interest}`,
            note ? `Note: ${note}` : null,
            "",
            "Sent from shaheen.works book-call form.",
          ]
            .filter(Boolean)
            .join("\n"),
        );
        window.location.href = `mailto:${contactEmail}?subject=${subject}&body=${body}`;
      };

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const name = String(data.get("name") ?? "").trim();
        const email = String(data.get("email") ?? "").trim();
        const interest = String(data.get("interest") ?? "hybrid");
        const note = String(data.get("note") ?? "").trim();

        if (!name || !email) {
          say("Name and work email are required.");
          return;
        }

        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          say("Please enter a valid work email.");
          return;
        }

        setBusy(true);
        say("Sending…");

        const encoded = new URLSearchParams();
        data.forEach((value, key) => encoded.append(key, String(value)));

        fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: encoded.toString(),
        })
          .then((res) => {
            if (!res.ok) throw new Error(`form-${res.status}`);
            form.reset();
            setBusy(false);
            if (appointmentUrl) {
              window.open(appointmentUrl, "_blank", "noopener,noreferrer");
              say("Note sent. Opening the calendar — pick a slot to lock it in.");
            } else {
              say("Sent. I reply within 24–48 hours.");
            }
          })
          .catch(() => {
            // Form service unreachable (offline, blocker): fall back to mail app.
            setBusy(false);
            openMailDraft(name, email, interest, note);
            say("Couldn't reach the form service — opened your email app with the note instead.");
          });
      });
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bindBookForms);
  } else {
    bindBookForms();
  }
  document.addEventListener("astro:after-swap", bindBookForms);
</script>
