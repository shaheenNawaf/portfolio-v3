---
import { softwareFit, marketingFit, trustLogos } from "../data/resume";
---

<section id="fit">
  <h2 class="text-[15px] font-semibold tracking-tight">Two lanes, one owner</h2>
  <p class="mt-1 text-[13px] muted">
    Engineering and growth, shipped by the same person. The work below filters
    by lane — the hybrid is the point.
  </p>
  <div class="mt-6 grid sm:grid-cols-2">
    <div class="pb-8 sm:pb-0 sm:pr-8">
      <p
        class="sticker-li inline-flex w-fit items-center rounded-full border border-[color:var(--sticker-bd)] bg-[color:var(--sticker-bg)] px-2 py-0.5 text-xs font-medium text-[color:var(--sticker-fg)]"
      >
        Software Engineering
      </p>
      <ul class="mt-5 space-y-3">
        {
          softwareFit.map((item) => (
            <li class="flex items-start gap-2.5 text-[14px] muted leading-[1.55]">
              <span
                class="mt-[6px] w-1.5 h-1.5 rounded-full shrink-0"
                style="background-color: var(--sw)"
                aria-hidden="true"
              />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="border-t hairline pt-8 sm:border-t-0 sm:border-l sm:pt-0 sm:pl-8">
      <p
        class="sticker-mail inline-flex w-fit items-center rounded-full border border-[color:var(--sticker-bd)] bg-[color:var(--sticker-bg)] px-2 py-0.5 text-xs font-medium text-[color:var(--sticker-fg)]"
      >
        Growth Marketing
      </p>
      <ul class="mt-5 space-y-3">
        {
          marketingFit.map((item) => (
            <li class="flex items-start gap-2.5 text-[14px] muted leading-[1.55]">
              <span
                class="mt-[6px] w-1.5 h-1.5 rounded-full shrink-0"
                style="background-color: var(--mkt)"
                aria-hidden="true"
              />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
    <p class="text-[12px] faint">Companies I've Worked With</p>
    <ul class="flex flex-wrap items-center gap-5">
      {
        trustLogos.map((l) => (
          <li class="flex items-center">
            <img
              src={l.src}
              alt={`${l.alt} logo`}
              width="150"
              height="150"
              loading="lazy"
              decoding="async"
              class:list={[
                "h-9 w-auto object-contain",
                l.alt === "Epulze" &&
                  "brightness-0 opacity-75 dark:brightness-100 dark:opacity-100",
              ]}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>