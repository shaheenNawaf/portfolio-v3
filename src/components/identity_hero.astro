---
import { softwareTools, marketingTools, sharedTools, socials } from "../data/resume";
import StickerPill from "./sticker_pill.astro";

interface Props {
  name: string;
  headline: string;
  summary: string;
  skills: readonly string[];
  mode: "software" | "marketing";
  impactBadge?: string;
}

const {
  name,
  headline,
  summary,
  skills,
  mode,
  impactBadge,
} = Astro.props;

const tools = [
  ...(mode === "software" ? softwareTools : marketingTools),
  ...sharedTools,
];

const linkedin = socials.find((s) => s.id === "linkedin")!;
const resume = socials.find((s) => s.id === (mode === "software" ? "resume-swe" : "resume-mkt"))!;
---

<header class="pt-4" data-reveal="hero" style="--i:1">
  {impactBadge && <p class="eyebrow">{impactBadge}</p>}
  <h1
    class="mt-3 text-[22px] md:text-[26px] font-medium tracking-[-0.01em] leading-[1.2]"
  >
    {name}
  </h1>
  <p class="mt-1 muted text-[15px] md:text-[16px]">{headline}</p>
  <p class="mt-5 text-[15px] muted leading-[1.7] max-w-[60ch]">{summary}</p>
  <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3 text-[13px]">
    <a
      href="#book-call"
      data-ui-sound="crisp"
      class="font-semibold transition-opacity hover:opacity-70"
      style={`color: var(--accent)`}
      >Book intro call →</a
    >
    <StickerPill social={linkedin} idPrefix="zone-" />
    <StickerPill social={resume} idPrefix="zone-" />
  </div>
  <div class="mt-10 border-t hairline pt-6">
    <p class="eyebrow mb-3">Expertise</p>
    <p class="text-[13px] muted leading-relaxed">{skills.join(" · ")}</p>
  </div>
  <div class="mt-6 border-t hairline pt-6">
    <p class="eyebrow mb-3">Tools</p>
    <p class="text-[13px] muted leading-relaxed">{tools.join(" · ")}</p>
  </div>
</header>
